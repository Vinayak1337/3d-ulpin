{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "table",
            "message": "Use <DataTable> from the design system instead of <table>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/Button/**",
              "components/actions/SegmentedControl/**",
              "components/engineering/DigColumn/**",
              "components/forms/Field/**",
              "components/forms/Toggle/**",
              "components/foundations/Icon/**",
              "components/identity/UlpinCode/**",
              "components/intake/ImportStream/**",
              "components/layout/DataTable/**",
              "components/layout/DescriptionList/**",
              "components/layout/Panel/**",
              "components/layout/Tabs/**",
              "components/map-and-3d/LayerPanel/**",
              "components/map-and-3d/Legend/**",
              "components/map-and-3d/LevelRail/**",
              "components/map-and-3d/MapCanvas/**",
              "components/map-and-3d/MapPatterns/**",
              "components/map-and-3d/MapStyle/**",
              "components/map-and-3d/MapToolbar/**",
              "components/map-and-3d/StrataSection/**",
              "components/output/PropertyCard/**",
              "components/record/CarpetAreaCheck/**",
              "components/record/EvidenceChip/**",
              "components/record/Inspector/**",
              "components/record/ReadinessMeter/**",
              "components/record/ShareLedger/**",
              "components/review/FindingCard/**",
              "components/review/RevisionTimeline/**",
              "components/shell/PortalHeader/**",
              "components/shell/StudioHeader/**",
              "components/shell/Wordmark/**",
              "components/status/Badge/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans Devanagari|Noto Sans|Noto Sans Display|Noto Sans Mono))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans Devanagari, Noto Sans, Noto Sans Display, Noto Sans Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|tone|icon|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: status, tone, icon, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:Draft|Needs evidence|Needs review|Reviewed|Recorded|Assigned|Retired|Cancelled|Unknown|Not assessed|Not comparable|Test fixture|Blocking|Provisional|Passed)$/]",
        "message": "<Badge> status must be one of 'Draft' | 'Needs evidence' | 'Needs review' | 'Reviewed' | 'Recorded' | 'Assigned' | 'Retired' | 'Cancelled' | 'Unknown' | 'Not assessed' | 'Not comparable' | 'Test fixture' | 'Blocking' | 'Provisional' | 'Passed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|warning|danger|info|primary)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'success' | 'warning' | 'danger' | 'info' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconOnly|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconOnly, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:danger|primary|default|soft|ghost)$/]",
        "message": "<Button> variant must be one of 'danger' | 'primary' | 'default' | 'soft' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarpetAreaCheck'] > JSXAttribute > JSXIdentifier[name!=/^(?:unit|grossInternal|deductions|declared|declaredEvidence|tolerancePct|style|key|ref|className|style|children)$/]",
        "message": "<CarpetAreaCheck> doesn't accept that prop. Declared props: unit, grossInternal, deductions, declared, declaredEvidence, tolerancePct, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|more|footer|hideHeader|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, more, footer, hideHeader."
      },
      {
        "selector": "JSXOpeningElement[name.name='DescriptionList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<DescriptionList> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='DigColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|range|bands|nearby|nearbyLabel|actions|style|key|ref|className|style|children)$/]",
        "message": "<DigColumn> doesn't accept that prop. Declared props: title, range, bands, nearby, nearbyLabel, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|locator|state|kind|icon|href|onClick|key|ref|className|style|children)$/]",
        "message": "<EvidenceChip> doesn't accept that prop. Declared props: source, locator, state, kind, icon, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:linked|estimated|missing)$/]",
        "message": "<EvidenceChip> state must be one of 'linked' | 'estimated' | 'missing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceChip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:document|table|feature)$/]",
        "message": "<EvidenceChip> kind must be one of 'document' | 'table' | 'feature'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|help|error|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, help, error, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FindingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|title|method|calculation|evidence|actions|style|key|ref|className|style|children)$/]",
        "message": "<FindingCard> doesn't accept that prop. Declared props: severity, title, method, calculation, evidence, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FindingCard'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:info|blocking|needs-review|not-assessed)$/]",
        "message": "<FindingCard> severity must be one of 'info' | 'blocking' | 'needs-review' | 'not-assessed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|children|className|id|style|ref|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, children, className, id, style, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Icon> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImportStream'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|rows|style|key|ref|className|style|children)$/]",
        "message": "<ImportStream> doesn't accept that prop. Declared props: title, meta, rows, style."
      },
