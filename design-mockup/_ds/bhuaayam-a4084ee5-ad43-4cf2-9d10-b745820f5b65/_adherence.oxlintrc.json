        "selector": "JSXOpeningElement[name.name='Inspector'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|status|code|location|tabs|activeTab|onTabChange|facts|children|primaryAction|secondaryAction|wide|style|key|ref|className|style|children)$/]",
        "message": "<Inspector> doesn't accept that prop. Declared props: title, status, code, location, tabs, activeTab, onTabChange, facts, children, primaryAction, secondaryAction, wide, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Inspector'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:Draft|Needs evidence|Needs review|Reviewed|Recorded|Assigned|Retired|Cancelled|Unknown|Not assessed|Not comparable|Test fixture|Blocking|Provisional|Passed)$/]",
        "message": "<Inspector> status must be one of 'Draft' | 'Needs evidence' | 'Needs review' | 'Reviewed' | 'Recorded' | 'Assigned' | 'Retired' | 'Cancelled' | 'Unknown' | 'Not assessed' | 'Not comparable' | 'Test fixture' | 'Blocking' | 'Provisional' | 'Passed'."
