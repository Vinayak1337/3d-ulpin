[Unit]
Description=BhuAayam NestJS API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ulpin/app
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=4096
EnvironmentFile=/opt/ulpin/app/.env
EnvironmentFile=/opt/ulpin/shared/runtime.env
ExecStart=/usr/local/bin/pnpm --filter @ulpin/api start:built
Restart=always
RestartSec=5
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
