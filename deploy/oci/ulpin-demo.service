[Unit]
Description=BhuAayam hosted dataset transport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ulpin/app
Environment=NODE_ENV=production
Environment=PROJ_NETWORK=OFF
EnvironmentFile=/opt/ulpin/shared/demo.env
ExecStart=/usr/local/bin/node scripts/demo-import/server.mjs
Restart=always
RestartSec=5
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
