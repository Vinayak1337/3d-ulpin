            "additionalProperties": false
          },
          "note": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u001f\\u007f]{1,1024}(?![\\s\\S])"
          },
          "changeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          }
        },
        "required": [
          "id",
          "revision",
          "kind",
          "from",
          "to",
          "note"
        ],
        "additionalProperties": false
      }
