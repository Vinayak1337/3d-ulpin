{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "entities": {
      "readOnly": true,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "ref": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
              }
            },
            "required": [
              "namespace",
              "id"
            ],
            "additionalProperties": false
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "building",
              "building_part",
              "level",
              "space",
              "parcel",
              "road",
              "rail",
              "utility",
              "utility_network",
              "road_network",
              "rail_network",
              "public_land",
              "terrain",
              "vegetation",
              "registry_record"
            ]
          },
          "label": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}(?![\\s\\S])"
          },
          "identifiers": {
            "readOnly": true,
            "maxItems": 100,
            "type": "array",
            "items": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
                },
                "issuer": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f]{1,256}(?![\\s\\S])"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f\\u007f]{1,512}(?![\\s\\S])"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "reported",
                    "prototype",
                    "verified"
                  ]
                },
                "historical": {
                  "type": "boolean"
                }
              },
              "required": [
                "scheme",
                "issuer",
                "value",
                "status",
                "historical"
              ],
              "additionalProperties": false
            }
          },
          "memberships": {
            "readOnly": true,
            "maxItems": 256,
            "type": "array",
            "items": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "collection": {
                  "readOnly": true,
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "namespace",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "authoring",
                    "coverage",
                    "administrative"
                  ]
                }
              },
              "required": [
                "collection",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "lifecycle": {
            "oneOf": [
              {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "active"
                  }
                },
                "required": [
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "const": "retired"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "split",
                      "merge"
                    ]
                  },
                  "changeId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
                  },
                  "replacedBy": {
                    "readOnly": true,
                    "minItems": 1,
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "readOnly": true,
                      "type": "object",
                      "properties": {
                        "namespace": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])"
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
                        }
                      },
                      "required": [
                        "namespace",
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "^[^\\u0000-\\u001f\\u007f]{1,1024}(?![\\s\\S])"
                  }
                },
                "required": [
                  "state",
                  "mode",
                  "changeId",
                  "replacedBy",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "ref",
          "revision",
          "kind",
          "label",
          "identifiers",
          "memberships",
          "lifecycle"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "readOnly": true,
      "maxItems": 40000,
