{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "representation": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "ref": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "const": "representation"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "additionalProperties": false
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ref",
        "revision"
      ],
      "additionalProperties": false
    },
    "definition": {
      "type": "string",
      "enum": [
        "horizontal_area",
        "prism_volume",
        "planar_length"
      ]
    }
  },
  "required": [
    "representation",
    "definition"
  ],
  "additionalProperties": false
}
