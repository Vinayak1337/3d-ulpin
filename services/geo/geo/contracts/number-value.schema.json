{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "readOnly": true,
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "known"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "readOnly": true,
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,1024}(?![\\s\\S])"
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "readOnly": true,
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "not_applicable"
        },
        "reason": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,1024}(?![\\s\\S])"
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "readOnly": true,
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "withheld"
        },
        "reason": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,1024}(?![\\s\\S])"
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "readOnly": true,
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "conflicting"
        },
        "candidates": {
          "readOnly": true,
          "minItems": 2,
          "maxItems": 64,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "ref": {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "namespace": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
                  }
                },
                "required": [
                  "namespace",
                  "id"
                ],
                "additionalProperties": false
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "ref",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f]{1,1024}(?![\\s\\S])"
        }
      },
      "required": [
        "state",
        "candidates",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
