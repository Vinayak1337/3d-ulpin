{
  "task": "K13",
  "executedByWorker": false,
  "prerequisites": [
    "Runtime owner alone, after authorized rollout to ulpin-reh-01; API and dispatcher already running.",
    "Run from the integrated repository root. This command does not start, stop, configure or reset any runtime.",
    "Creates one new test workspace, retains the four unchanged originals sequentially, then reads their jobs.",
    "Native-only requests: no OCR, model or provider call; no review, registry, packet or card writes.",
    "Retain stdout as owner evidence; first unknown/refused write stops. Never blindly rerun an unknown outcome."
  ],
  "commandFragments": [
    "node --input-type=module -e \"$(node -p",
    "\"require('./docs/evidence/gf1/k13/runtime-owner-command.json').program.join('\\n')\")\""
  ],
  "commandJoining": "Join fragments with one space to get the single Bash command.",
  "shell": "Bash; program is supplied below, not executed or imported during worker verification.",
  "program": [
    "import assert from 'node:assert/strict';",
    "import { readFile } from 'node:fs/promises';",
    "import { createHash, randomUUID } from 'node:crypto';",
    "import { setTimeout as sleep } from 'node:timers/promises';",
    "const evidence = JSON.parse(await readFile('docs/evidence/gf1/k13/result.json', 'utf8'));",
    "const originals = [];",
    "for (const pin of evidence.realInputs.nominated) {",
    "  const bytes = await readFile(evidence.realInputs.pathPrefix + pin.file);",
    "  assert.equal(createHash('sha256').update(bytes).digest('hex'), pin.sha256);",
    "  originals.push({ pin, bytes });",
    "}",
    "async function send(path, options = {}) {",
    "  const response = await fetch('http://127.0.0.1:21016' + path,",
    "    { ...options, redirect: 'error', signal: AbortSignal.timeout(30000) });",
    "  assert(response.ok, 'K13_HTTP_' + response.status);",
    "  return response.json();",
    "}",
    "const c = await send('/api/v1/cases', { method: 'POST',",
    "  headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: 'K13-public-originals' }) });",
    "console.log(JSON.stringify({ caseId: c.id, caseRevision: c.revision }));",
    "let revision = c.revision;",
    "const receipts = [];",
    "for (const { pin, bytes } of originals) {",
    "  const form = new FormData();",
    "  form.set('file', new File([bytes], pin.file, { type: 'application/pdf' }));",
    "  form.set('requestKey', randomUUID());",
    "  form.set('expectedCaseRevision', String(revision));",
    "  form.set('mode', 'native_only');",
    "  const receipt = await send('/api/v1/ingestion/cases/' + c.id + '/documents', { method: 'POST', body: form });",
    "  receipts.push(receipt);",
    "  revision = receipt.caseRevision;",
    "  console.log(JSON.stringify(receipt));",
    "}",
    "let statuses;",
    "for (let round = 0; round < 120; round++) {",
    "  statuses = [];",
    "  for (const r of receipts) {",
    "    const path = '/api/v1/ingestion/cases/' + c.id + '/sources/' + r.sourceId + '/documents/jobs/' + r.jobId;",
    "    const s = await send(path);",
    "    statuses.push({ jobId: s.jobId, status: s.status, code: s.code, native: s.native?.status ?? null });",
    "  }",
    "  if (statuses.every(s => !['queued', 'running'].includes(s.status))) break;",
    "  await sleep(2000);",
    "}",
    "console.log(JSON.stringify({ caseId: c.id, statuses }));",
    "assert(statuses.every(s => s.status === 'completed'), 'K13_BATCH_NOT_COMPLETED');"
  ],
  "qualification": "Completed jobs prove lifecycle only; state native outcomes honestly, including needs_ocr.",
  "refs": [
    "apps/api/src/modules/intake/cases.controller.ts:99-106",
    "apps/api/src/modules/ingestion/documents.controller.ts:15-31,33-42",
    "packages/server/src/modules/usp/ingestion/document-native.ts:68-75",
    "docs/evidence/gf-backend/k2/original-integrity.json"
  ]
}
