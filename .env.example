# scripts/platform-env.sh creates .env with strong local-only secrets.
# true selects isolated, persisted repository data. false preserves the settings below.
REPO_DATA=false
POSTGRES_DB=ulpin
POSTGRES_USER=ulpin
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://ulpin:replace-with-a-random-password@127.0.0.1:15432/ulpin
S3_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY=ulpinlocal
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=ulpin
S3_REGION=us-east-1
GEO_URL=http://127.0.0.1:18000
GEO_SERVICE_TOKEN=replace-with-a-random-token
REDIS_URL=redis://127.0.0.1:16379/0

# Optional server-only Nous assistance. Keep the actual key in ignored .env.
# The authenticated catalog must prove the selected route has zero fees.
NOUS_API_KEY=
# Legacy non-India route is disabled unless this is exactly 1. Finale must keep 0.
ULPIN_ALLOW_NON_INDIA_PROVIDER=0
ULPIN_RELEASE_PROFILE=finale_v1
# Host authorities must use loopback and one of these ports. Never add public hosts.
ULPIN_LOOPBACK_PORTS=3000
NOUS_MODEL=
NOUS_MAX_CALLS=2
NOUS_MAX_OUTPUT_TOKENS=3000
NOUS_TIMEOUT_MS=45000
