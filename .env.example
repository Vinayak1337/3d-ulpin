# scripts/platform-env.sh creates .env with strong local-only secrets.
POSTGRES_DB=ulpin
POSTGRES_USER=ulpin
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://ulpin:replace-with-a-random-password@127.0.0.1:15432/ulpin
S3_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY=ulpinlocal
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=ulpin
S3_REGION=us-east-1
GEO_URL=http://127.0.0.1:18000
GEO_SERVICE_TOKEN=replace-with-a-random-token
REDIS_URL=redis://127.0.0.1:16379/0
