*.pdf binary
*.png binary
*.sh text eol=lf
# Snapshot and presentation hashes must survive Windows autocrlf checkouts.
repo-data/** -text -diff
repo-data/README.md text eol=lf diff
repo-data/manifest.json -text diff
apps/web/public/scene-assets/** -text
fixtures/** -text
data-bundles/** -text
data-bundles/**/README.md text eol=lf diff
data-bundles/**/manifest.json -text diff
apps/web/public/datasets/** -text
fixtures/**/*.csv whitespace=cr-at-eol
