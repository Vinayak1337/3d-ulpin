docs/v2-design/design.md -text whitespace=-blank-at-eol
docs/evidence/v2/checks/*.txt -text whitespace=-blank-at-eol,-blank-at-eof

# Engineering tooling is portable; preserved planning inputs retain exact bytes.
docs/engineering-plan/** text eol=lf
docs/engineering-plan/legacy/** -text
packages/contracts/schemas/** -text
services/geo/geo/contracts/** -text

# Preserve original/source-package and screenshot bytes through every checkout.
apps/web/public/reference/** -text
