# Keep verified CSV source/export bytes, including CRLF, unchanged on checkout.
demo-data/synthetic-officer/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/evidence/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
demo-data/synthetic-v2-workspace/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

