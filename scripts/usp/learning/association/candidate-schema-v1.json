{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ulpin:ml:candidate-selection:1",
  "title": "Selection from one immutable native candidate set",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "candidateSetSha256", "selected"],
  "properties": {
    "version": {"const": "evidence-association-candidate-selection/1"},
    "candidateSetSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected": {
      "type": "array", "minItems": 0, "maxItems": 25, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^c(0|[1-9][0-9]*)$", "maxLength": 3}
    }
  }
}
