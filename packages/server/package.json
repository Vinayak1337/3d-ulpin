{
  "name": "@ulpin/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./modules/spatial/identifiers/records": {
      "types": "./src/modules/spatial/identifiers/records.d.ts",
      "default": "./src/modules/spatial/identifiers/records.js"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm typecheck && node scripts/build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@ulpin/contracts": "workspace:*",
    "dotenv": "^17.2.0",
    "earcut": "^3.0.2",
    "fflate": "0.8.2",
    "fontkit": "2.0.4",
    "geotiff": "3.0.5",
    "jspdf": "4.2.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "0.20.2",
    "pg": "^8.16.0",
    "playwright": "1.63.0",
    "qrcode": "1.5.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "esbuild": "^0.25.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "^5.9.0"
  }
}
