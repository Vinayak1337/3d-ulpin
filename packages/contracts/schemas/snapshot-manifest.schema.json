{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "ulpin-core-snapshot/1"
    },
    "state": {
      "type": "string",
      "const": "candidate"
    },
    "context": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "world": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "ref": {
              "readOnly": true,
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "const": "world"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
                }
              },
              "required": [
                "namespace",
                "id"
              ],
              "additionalProperties": false
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "ref",
            "revision"
          ],
          "additionalProperties": false
        },
        "asOfMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -8640000000000000,
              "maximum": 8640000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "ceiling": {
              "type": "string",
              "enum": [
                "public",
                "operator",
                "restricted"
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "ceiling"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "world",
        "asOfMs",
        "scope"
      ],
      "additionalProperties": false
    },
    "signatureVersion": {
      "type": "string",
      "const": "ulpin-tagged-binary64/1"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "geometryDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "representations": {
      "readOnly": true,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "ref": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "const": "representation"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
              }
            },
            "required": [
              "namespace",
              "id"
            ],
            "additionalProperties": false
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "ref",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "entities": {
      "readOnly": true,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "ref": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
              }
            },
            "required": [
              "namespace",
              "id"
            ],
            "additionalProperties": false
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "ref",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "retainedObservations": {
      "readOnly": true,
      "maxItems": 20000,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "ref": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "const": "observation"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
              }
            },
            "required": [
              "namespace",
              "id"
            ],
            "additionalProperties": false
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "ref",
          "revision"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "state",
    "context",
    "signatureVersion",
    "inputDigest",
    "geometryDigest",
    "representations",
    "entities",
    "retainedObservations"
  ],
  "additionalProperties": false
}
