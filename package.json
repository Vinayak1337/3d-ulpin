{
  "name": "3d-ulpin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "test:studio": "tsx --tsconfig apps/web/tsconfig.json --test tests/studio-*.test.ts",
    "test:uttam": "tsx --test tests/map-attribution.test.ts tests/neighbour-scenario-policy.test.ts tests/registry-reference-policy.test.ts",
    "dev": "concurrently -k -n api,dispatcher \"pnpm --filter @ulpin/api dev\" \"pnpm dispatcher\"",
    "build": "pnpm --filter @ulpin/server build && pnpm --filter @ulpin/api build",
    "start": "concurrently -k -n api,dispatcher \"pnpm --filter @ulpin/api start:built\" \"pnpm dispatcher\"",
    "web:dev": "pnpm --filter @ulpin/web dev",
    "web:build": "pnpm --filter @ulpin/web build",
    "web:start": "pnpm --filter @ulpin/web start",
    "web:typecheck": "pnpm --filter @ulpin/web typecheck",
    "studio:demo": "ULPIN_DEMO_IMPORT=1 VITE_DEMO_IMPORT=1 VITE_LOCAL_DATA=off pnpm --filter @ulpin/studio dev",
    "studio:dev": "pnpm --filter @ulpin/studio dev",
    "studio:build": "pnpm --filter @ulpin/studio build",
    "studio:typecheck": "pnpm --filter @ulpin/api-client --filter @ulpin/ui --filter @ulpin/scene --filter @ulpin/studio typecheck",
    "studio:test": "pnpm --filter @ulpin/api-client --filter @ulpin/ui --filter @ulpin/scene --filter @ulpin/studio --no-bail test",
    "studio:api-types": "pnpm --filter @ulpin/api-client generate",
    "studio:derive": "node apps/studio/scripts/derive-official-area.mjs",
    "web:demo": "bash scripts/demo-start.sh",
    "demo": "pnpm web:demo",
    "test:repo-data": "node --test tests/repo-data-mode.test.mjs",
    "dispatcher": "tsx scripts/dispatcher.ts",
    "api:dev": "pnpm --filter @ulpin/api dev",
    "api:start": "pnpm --filter @ulpin/api start",
    "api:build": "pnpm --filter @ulpin/api build",
    "server:build": "pnpm --filter @ulpin/server build",
    "typecheck:backend": "pnpm --filter @ulpin/server typecheck && pnpm --filter @ulpin/api typecheck",
    "platform:start": "bash scripts/platform-start.sh",
    "platform:health": "bash scripts/platform-health.sh",
    "platform:stop": "bash scripts/platform-stop.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "pnpm typecheck:backend",
    "lint:icons": "node scripts/usp/ui/icon-import-warning.mjs",
    "test:e2e": "playwright test",
    "test:scene": "tsx --test tests/building-scene.test.ts",
    "test:api": "tsx scripts/api-regression.ts",
    "test:area": "tsx scripts/verify-area.ts",
    "test:registry-reimport": "tsx scripts/verify-registry-reimport.ts",
    "test:registry-allocation": "tsx scripts/verify-registry-allocation.ts",
    "test:officer": "tsx scripts/verify-officer.ts",
    "test:block-membership": "tsx scripts/verify-block-membership.ts",
    "test:horizontal-performance": "tsx scripts/verify-horizontal-performance.ts",
    "test:fresh-install": "tsx scripts/verify-fresh-install.ts",
    "test:ai": "tsx --test tests/ai-extraction/*.test.ts",
    "test:ai-integration": "tsx tests/ai-extraction/integration.ts",
    "test:ui": "tsx --tsconfig apps/web/tsconfig.json --test tests/v2-*.test.ts apps/web/lib/legacy-url.test.ts apps/web/features/officer/workspace/measurement.test.ts",
    "test:register-scope": "tsx --test tests/register-scope.test.ts",
    "test:spatial": "tsx --test tests/spatial-core.test.ts",
    "test:spatial:browser": "node scripts/spatial/browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "fflate": "0.8.2",
    "jspdf": "4.2.1",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@ulpin/server": "workspace:*"
  }
}
