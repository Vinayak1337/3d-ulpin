{
  "name": "3d-ulpin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -k -n web,dispatcher 'pnpm --filter @ulpin/web dev' 'pnpm dispatcher'",
    "build": "pnpm --filter @ulpin/web build",
    "start": "concurrently -k -n web,dispatcher 'pnpm --filter @ulpin/web start' 'pnpm dispatcher'",
    "demo": "bash scripts/demo-start.sh",
    "dispatcher": "tsx scripts/dispatcher.ts",
    "platform:start": "bash scripts/platform-start.sh",
    "platform:health": "bash scripts/platform-health.sh",
    "platform:stop": "bash scripts/platform-stop.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "pnpm --filter @ulpin/web typecheck",
    "test:e2e": "playwright test",
    "test:scene": "tsx --test tests/building-scene.test.ts",
    "test:v2": "tsx --tsconfig apps/web/tsconfig.json --test tests/v2-*.test.ts apps/web/lib/legacy-url.test.ts apps/web/features/officer/workspace/measurement.test.ts",
    "test:case-document-copy": "tsx scripts/verify-case-document-copy.ts",
    "test:demo": "tsx scripts/verify-demo.ts",
    "test:api": "tsx scripts/api-regression.ts",
    "test:registry": "tsx scripts/verify-registry.ts",
    "test:area": "tsx scripts/verify-area.ts",
    "test:registry-reimport": "tsx scripts/verify-registry-reimport.ts",
    "test:registry-allocation": "tsx scripts/verify-registry-allocation.ts",
    "test:officer": "tsx scripts/verify-officer.ts",
    "test:block-membership": "tsx scripts/verify-block-membership.ts",
    "test:horizontal-performance": "tsx scripts/verify-horizontal-performance.ts",
    "test:fresh-install": "tsx scripts/verify-fresh-install.ts",
    "test:ai": "tsx --test tests/ai-extraction/*.test.ts",
    "test:ai-integration": "tsx tests/ai-extraction/integration.ts",
    "demo:seed": "tsx scripts/reference/seed.ts",
    "test:ui": "tsx --tsconfig apps/web/tsconfig.json --test tests/v2-*.test.ts apps/web/lib/legacy-url.test.ts apps/web/features/officer/workspace/measurement.test.ts",
    "test:reference": "tsx scripts/reference/verify.ts",
    "test:reference:browser": "tsx scripts/reference/browser.ts",
    "test:reference:investigation": "tsx scripts/reference/investigation-browser.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
