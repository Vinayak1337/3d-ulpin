{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "label": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f]{1,64}(?![\\s\\S])"
    },
    "sourceRevision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "point": {
      "readOnly": true,
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "known"
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "enum": [
                "m",
                "ft",
                "mm"
              ]
            }
          },
          "required": [
            "state",
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f]{1,64}(?![\\s\\S])"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "related": {
      "readOnly": true,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}(?![\\s\\S])"
      }
    }
  },
  "required": [
    "id",
    "revision",
    "label",
    "sourceRevision",
    "point",
    "observation",
    "related"
  ],
  "additionalProperties": false
}
